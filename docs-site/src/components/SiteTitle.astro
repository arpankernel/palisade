---
// Starlight exposes `config.title` as a locale map, not a string - render the
// constant directly rather than coupling to that shape.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<a href={base + "/"} class="site-title sl-flex">
  <svg viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
    <rect x="4" y="6" width="6" height="22" fill="currentColor" opacity="0.8"></rect>
    <rect x="13" y="2" width="6" height="26" fill="#6E1F2A"></rect>
    <rect x="22" y="6" width="6" height="22" fill="currentColor" opacity="0.8"></rect>
  </svg>
  <span>Palisade</span>
</a>
<style>
  .site-title {
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-h4);
  }
  .site-title svg { flex: none; }
  .site-title span {
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
</style>
